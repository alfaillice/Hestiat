---
import kits from '../data/kits.json';
import tienda from '../data/tienda.json';

interface Componente {
  cantidad: number;
  nombre: string;
  especificacion: string;
}

interface Kit {
  id: string;
  nombre: string;
  slug: string;
  voltaje: string | null;
  capacidad_wh: number | null;
  potencia_solar_w: number | null;
  potencia_inversor_w: number | null;
  precio_eur: number | null;
  checkout_url: string | null;
  imagen: string | null;
  uso_ideal: string;
  componentes: Componente[];
}

interface Props {
  kitId: string;
  mostrarCrossSell?: boolean;
}

const { kitId, mostrarCrossSell = true } = Astro.props;
const allKits = kits as Kit[];
const kitInicial = allKits.find((k) => k.id === kitId) || allKits[0];
const kitProtecciones = allKits.find((k) => k.id === 'kit-protecciones-pro');
const mostrarPackExtra = mostrarCrossSell && kitProtecciones && kitInicial.id !== 'kit-protecciones-pro';
const tiendaData = tienda as any;
const enlacesTienda = (kitId: string, nombre: string): any[] =>
  ((tiendaData.kits[kitId] || {})[nombre] || []).map((id: string) => tiendaData.productos[id]).filter(Boolean);
---

<aside class="recomendador-wrapper" data-recomendador-root>
  <div class="kit-card" data-kit-container>
    <div class="kit-header">
      <span class="kit-badge">Configuración recomendada</span>
      <h3 class="kit-title" data-kit-nombre>{kitInicial.nombre}</h3>
      <p class="kit-uso" data-kit-uso>{kitInicial.uso_ideal}</p>
    </div>

    <div class="kit-media" data-kit-imagen-box hidden={!kitInicial.imagen}>
      {kitInicial.imagen && (
        <img src={kitInicial.imagen} alt={kitInicial.nombre} loading="lazy" data-kit-imagen />
      )}
    </div>

    <div class="kit-specs" data-kit-specs>
      {kitInicial.voltaje && (
        <span class="spec-pill" data-spec-voltaje>Tensión: {kitInicial.voltaje}</span>
      )}
      {kitInicial.capacidad_wh && (
        <span class="spec-pill" data-spec-capacidad>Batería: {kitInicial.capacidad_wh} Wh</span>
      )}
      {kitInicial.potencia_solar_w && (
        <span class="spec-pill" data-spec-solar>Solar: {kitInicial.potencia_solar_w} W</span>
      )}
      {kitInicial.potencia_inversor_w && (
        <span class="spec-pill" data-spec-inversor>Inversor: {kitInicial.potencia_inversor_w} W</span>
      )}
    </div>

    <div class="kit-componentes">
      <h4>Material incluido en este paquete:</h4>
      <ul data-kit-lista>
        {kitInicial.componentes.map((comp) => (
          <li>
            <strong>{comp.cantidad}x {comp.nombre}</strong>
            <span> — {comp.especificacion}</span>
            {enlacesTienda(kitInicial.id, comp.nombre).map((p: any) => (
              <a class="kit-tienda" href={p.url} rel="noopener">Ver en la tienda: {p.titulo}</a>
            ))}
          </li>
        ))}
      </ul>
    </div>

    <div
      class="kit-footer"
      data-kit-footer
      hidden={kitInicial.precio_eur === null && kitInicial.checkout_url === null}
    >
      <div class="kit-precio-box" data-kit-precio-box hidden={kitInicial.precio_eur === null}>
        {kitInicial.precio_eur !== null && (
          <span class="kit-precio" data-kit-precio>{kitInicial.precio_eur.toFixed(2)} €</span>
        )}
      </div>

      <div class="kit-cta-box" data-kit-cta-box hidden={kitInicial.checkout_url === null}>
        {kitInicial.checkout_url && (
          <a
            href={kitInicial.checkout_url}
            class="kit-btn-comprar"
            rel="nofollow sponsored"
            data-kit-link
          >
            Comprar paquete completo
          </a>
        )}
      </div>
    </div>
  </div>

  {mostrarPackExtra && kitProtecciones && (
    <div class="cross-sell-card" data-cross-sell>
      <div class="cross-sell-info">
        <strong>Accesorio recomendado: {kitProtecciones.nombre}</strong>
        <p>{kitProtecciones.uso_ideal}</p>
      </div>
      {(kitProtecciones.precio_eur !== null || kitProtecciones.checkout_url !== null) && (
        <div class="cross-sell-actions">
          {kitProtecciones.precio_eur !== null && (
            <span class="cross-sell-precio">{kitProtecciones.precio_eur.toFixed(2)} €</span>
          )}
          {kitProtecciones.checkout_url && (
            <a href={kitProtecciones.checkout_url} class="cross-sell-btn" rel="nofollow sponsored">
              Añadir protecciones
            </a>
          )}
        </div>
      )}
    </div>
  )}

  <script type="application/json" id="hestiat-kits-catalog" set:html={JSON.stringify(allKits)} />
  <script type="application/json" id="hestiat-tienda" set:html={JSON.stringify({ kits: tiendaData.kits, productos: tiendaData.productos })} />
</aside>

<script>
  const catalogEl = document.getElementById('hestiat-kits-catalog');
  if (catalogEl) {
    const kitsData = JSON.parse(catalogEl.textContent || '[]');
    const tiendaEl = document.getElementById('hestiat-tienda');
    const tiendaData = tiendaEl ? JSON.parse(tiendaEl.textContent || '{}') : { kits: {}, productos: {} };
    const enlacesHtml = (kitId, nombre) => ((tiendaData.kits[kitId] || {})[nombre] || [])
      .map((id) => tiendaData.productos[id])
      .filter(Boolean)
      .map((p) => `<a class="kit-tienda" href="${p.url}" rel="noopener">Ver en la tienda: ${p.titulo}</a>`)
      .join('');

    window.addEventListener('actualizar-kit', (event) => {
      const customEvent = event as CustomEvent<{ kitId: string }>;
      const nuevoId = customEvent.detail?.kitId;
      if (!nuevoId) return;

      const kit = kitsData.find((k: any) => k.id === nuevoId);
      if (!kit) return;

      const root = document.querySelector('[data-recomendador-root]');
      if (!root) return;

      const nombreEl = root.querySelector('[data-kit-nombre]');
      const usoEl = root.querySelector('[data-kit-uso]');
      if (nombreEl) nombreEl.textContent = kit.nombre;
      if (usoEl) usoEl.textContent = kit.uso_ideal;

      // Imagen condicional
      const imgBox = root.querySelector('[data-kit-imagen-box]') as HTMLElement;
      if (imgBox) {
        if (kit.imagen) {
          imgBox.hidden = false;
          imgBox.innerHTML = `<img src="${kit.imagen}" alt="${kit.nombre}" loading="lazy" />`;
        } else {
          imgBox.hidden = true;
          imgBox.innerHTML = '';
        }
      }

      // Especificaciones condicionales
      const specsBox = root.querySelector('[data-kit-specs]');
      if (specsBox) {
        const pills: string[] = [];
        if (kit.voltaje) pills.push(`<span class="spec-pill">Tensión: ${kit.voltaje}</span>`);
        if (kit.capacidad_wh) pills.push(`<span class="spec-pill">Batería: ${kit.capacidad_wh} Wh</span>`);
        if (kit.potencia_solar_w) pills.push(`<span class="spec-pill">Solar: ${kit.potencia_solar_w} W</span>`);
        if (kit.potencia_inversor_w) pills.push(`<span class="spec-pill">Inversor: ${kit.potencia_inversor_w} W</span>`);
        specsBox.innerHTML = pills.join('');
      }

      // Componentes
      const listaEl = root.querySelector('[data-kit-lista]');
      if (listaEl && Array.isArray(kit.componentes)) {
        listaEl.innerHTML = kit.componentes
          .map(
            (c: any) =>
              `<li><strong>${c.cantidad}x ${c.nombre}</strong><span> — ${c.especificacion}</span>${enlacesHtml(kit.id, c.nombre)}</li>`
          )
          .join('');
      }

      // Footer (Precio y Botón estrictamente condicionales)
      const footerEl = root.querySelector('[data-kit-footer]') as HTMLElement;
      const precioBox = root.querySelector('[data-kit-precio-box]') as HTMLElement;
      const ctaBox = root.querySelector('[data-kit-cta-box]') as HTMLElement;

      const tienePrecio = kit.precio_eur !== null && kit.precio_eur !== undefined;
      const tieneEnlace = Boolean(kit.checkout_url);

      if (precioBox) {
        precioBox.hidden = !tienePrecio;
        precioBox.innerHTML = tienePrecio
          ? `<span class="kit-precio">${Number(kit.precio_eur).toFixed(2)} €</span>`
          : '';
      }

      if (ctaBox) {
        ctaBox.hidden = !tieneEnlace;
        ctaBox.innerHTML = tieneEnlace
          ? `<a href="${kit.checkout_url}" class="kit-btn-comprar" rel="nofollow sponsored">Comprar paquete completo</a>`
          : '';
      }

      if (footerEl) {
        footerEl.hidden = !tienePrecio && !tieneEnlace;
      }

      // Ocultar cross-sell si el kit seleccionado ya es el pack de protecciones
      const crossSellEl = root.querySelector('[data-cross-sell]') as HTMLElement;
      if (crossSellEl) {
        crossSellEl.hidden = kit.id === 'kit-protecciones-pro';
      }
    });
  }
</script>

<style>
  .recomendador-wrapper {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .kit-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--paper);
  }
  .kit-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--navy);
    background: var(--surface-2);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-s);
    margin-bottom: 0.5rem;
  }
  .kit-title {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.35rem;
    color: var(--ink);
  }
  .kit-uso {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .kit-media img {
    width: 100%;
    max-height: 260px;
    object-fit: contain;
    border-radius: var(--radius-s);
    margin-bottom: 1rem;
    background: var(--surface);
  }
  .kit-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .spec-pill {
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-s);
  }
  .kit-componentes h4 {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .kit-componentes ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .kit-footer {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .kit-precio {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--ink);
  }
  .kit-btn-comprar {
    display: inline-block;
    background: var(--sun);
    color: var(--sun-ink);
    font-weight: 600;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--pill);
    transition: background-color 0.15s ease;
  }
  .kit-btn-comprar:hover {
    background: var(--sun-hover);
  }
  .cross-sell-card {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    background: var(--surface);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cross-sell-info p {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .cross-sell-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cross-sell-precio {
    font-weight: 700;
    color: var(--ink);
  }
  .cross-sell-btn {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    padding: 0.45rem 0.9rem;
    border-radius: var(--pill);
    text-decoration: none;
  }
  .cross-sell-btn:hover {
    background: var(--paper);
    border-color: var(--ink);
  }
  .kit-componentes .kit-tienda { display: block; margin-top: 4px; font-size: 0.88rem; font-weight: 600; color: var(--ink); text-decoration: underline; text-decoration-color: var(--sun); text-decoration-thickness: 2px; text-underline-offset: 4px; }
</style>
