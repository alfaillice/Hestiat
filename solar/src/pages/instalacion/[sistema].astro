---
import Base from "../../layouts/Base.astro";
import Esquema from "../../components/Esquema.astro";
import Ilustra from "../../components/Ilustra.astro";
import Producto from "../../components/Producto.astro";
import sistemas from "../../data/sistemas.json";
import tienda from "../../data/tienda.json";

export function getStaticPaths() {
  return Object.keys(sistemas).map((sistema) => ({ params: { sistema } }));
}

const { sistema } = Astro.params;
const s = (sistemas as Record<string, any>)[sistema as string];
const t = tienda as any;
const mapaSistema: Record<string, string[]> = t.sistemas[sistema as string] || {};

// Foto de cada componente: primero la del artículo real de la tienda; si no hay, la ilustración generada.
const fotosIA: Record<string, string> = {
  bateria: "/img/bateria-lfp.png",
  mppt: "/img/regulador-mppt.png",
};
const fotoComponente = (tipo: string): string | undefined => {
  const ids = mapaSistema[tipo] || [];
  const con = ids.map((id) => t.productos[id]).find((p: any) => p && p.imagen);
  return con ? con.imagen : fotosIA[tipo];
};
const enlacesComponente = (tipo: string) => (mapaSistema[tipo] || []).map((id) => t.productos[id]).filter(Boolean);

// Material del sistema, sin repetir artículos
const idsMaterial = [...new Set(Object.values(mapaSistema).flat())];
---
<Base title={`${s.titulo} · esquema de instalación`} description={`Esquema e instalación de un sistema solar ${s.titulo}: componentes, protecciones y cuándo elegirlo.`}>
  <section class="sec">
    <div class="wrap wrap-print">
      <header class="sec-head">
        <h1>{s.titulo}</h1>
        <p>{s.intro}</p>
      </header>

      <Esquema />

      <h2 class="titulo-bloque">Componentes de este sistema</h2>
      <ul class="comp-grid">
        {s.componentes.map((c: { tipo: string; texto: string }) => (
          <li class="comp">
            <Ilustra tipo={c.tipo} foto={fotoComponente(c.tipo)} />
            <p>{c.texto}</p>
            {enlacesComponente(c.tipo).slice(0, 1).map((p: any) => (
              <a class="comp-tienda" href={p.url} rel="noopener">Ver en la tienda: {p.titulo}</a>
            ))}
          </li>
        ))}
      </ul>

      {idsMaterial.length > 0 && (
        <>
          <h2 class="titulo-bloque">Material en la tienda</h2>
          <ul class="material-grid">
            {idsMaterial.map((id) => (
              <li><Producto id={id} /></li>
            ))}
          </ul>
          <p class="material-nota">Solo aparecen los artículos que vendemos. Para el resto de componentes, confirma el modelo con tu instalador.</p>
        </>
      )}

      <div class="dos-col" style="margin-top:40px">
        <div class="bloque">
          <h3>Cuándo elegir este sistema</h3>
          <p class="m">{s.cuando}</p>
          <p class="aviso-nota">Las secciones de cable y las protecciones concretas dependen de las potencias y las distancias de tu instalación; confírmalas con un instalador antes de comprar.</p>
        </div>
        <div class="bloque">
          <h3>Guardar la ficha</h3>
          <p class="m">Imprime esta página para llevarla al instalador: esquema y componentes, sin menú ni pie.</p>
          <button type="button" class="btn btn-ghost" id="imprimir">Guardar como PDF (imprimir)</button>
        </div>
      </div>
    </div>
  </section>
  <script>
    document.getElementById("imprimir")?.addEventListener("click", () => window.print());
  </script>
</Base>

<style>
  .comp-tienda { margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--ink); text-decoration: underline; text-decoration-color: var(--sun); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .comp-tienda { display: block; }
</style>
