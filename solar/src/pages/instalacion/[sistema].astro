---
import Base from "../../layouts/Base.astro";
import Esquema from "../../components/Esquema.astro";
import sistemas from "../../data/sistemas.json";

export function getStaticPaths() {
  return Object.keys(sistemas).map((sistema) => ({ params: { sistema } }));
}

const { sistema } = Astro.params;
const s = (sistemas as Record<string, any>)[sistema as string];
---
<Base title={`${s.titulo} · esquema de instalación`} description={`Esquema e instalación de un sistema solar ${s.titulo}: componentes, protecciones y cuándo elegirlo.`}>
  <section class="sec">
    <div class="wrap wrap-print">
      <div class="sec-head">
        <h2>{s.titulo}</h2>
        <p>{s.intro}</p>
      </div>

      <Esquema />

      <div class="dos-col" style="margin-top:28px">
        <div class="bloque">
          <h3>Componentes</h3>
          <ul class="lista-check">
            {s.componentes.map((c: string) => <li>{c}</li>)}
          </ul>
        </div>
        <div class="bloque">
          <h3>Cuándo elegir este sistema</h3>
          <p class="m">{s.cuando}</p>
          <p class="aviso-nota">Las secciones de cable y las protecciones concretas dependen de las potencias y las distancias de tu instalación; confírmalas con un instalador antes de comprar.</p>
          <button type="button" class="btn btn-ghost" id="imprimir">Guardar como PDF (imprimir)</button>
        </div>
      </div>
    </div>
  </section>
  <script>
    document.getElementById("imprimir")?.addEventListener("click", () => window.print());
  </script>
</Base>
