DATABASE_URL=postgresql://hestiat:hestiat@localhost:5432/hestiat?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional specialist/advisor model. If empty, Hestiat falls back to OPENAI_MODEL.
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6-luna
OPENAI_ADVISOR_MODEL=gpt-5.6-luna

# Notifications
EMAIL_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=

# Transactional email — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hestiat <noreply@hestiat.com>

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-this-random-token
WHATSAPP_APP_SECRET=

# Operations worker
WORKER_BATCH_SIZE=10
WORKER_POLL_MS=1000
OPERATIONS_HEALTH_SECRET=change-me

# Runtime
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hestiat IA — OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6-luna
OPENAI_ADVISOR_MODEL=gpt-5.6-luna
