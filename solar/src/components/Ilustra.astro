---
// Ilustración vectorial propia de cada componente de una instalación. Sin imágenes de stock ni marcas.
const { tipo } = Astro.props;
const etiquetas: Record<string, string> = {
  panel: "Panel solar",
  mppt: "Regulador MPPT",
  bateria: "Batería LFP",
  inversor: "Inversor",
  proteccion: "Protecciones",
  cable: "Cableado",
  red: "Conexión a la red",
};
---
<svg class="il" viewBox="0 0 160 120" role="img" aria-label={etiquetas[tipo]}>
  <rect x="1" y="1" width="158" height="118" rx="10" class="il-base" />

  {tipo === "panel" && (
    <g>
      <polygon points="34,38 122,30 130,80 42,88" class="il-face" />
      <line x1="63.3" y1="35.3" x2="71.3" y2="85.3" class="il-grid" />
      <line x1="92.7" y1="32.7" x2="100.7" y2="82.7" class="il-grid" />
      <line x1="38" y1="63" x2="126" y2="55" class="il-grid" />
      <circle cx="138" cy="22" r="6" class="il-sun" />
    </g>
  )}

  {tipo === "mppt" && (
    <g>
      <rect x="32" y="34" width="96" height="52" rx="5" class="il-body" />
      <rect x="44" y="45" width="34" height="18" rx="3" class="il-screen" />
      <line x1="90" y1="50" x2="116" y2="50" class="il-line" />
      <line x1="90" y1="58" x2="112" y2="58" class="il-line" />
      <line x1="90" y1="66" x2="106" y2="66" class="il-line" />
      <line x1="44" y1="76" x2="116" y2="76" class="il-line-soft" />
    </g>
  )}

  {tipo === "bateria" && (
    <g>
      <rect x="34" y="36" width="80" height="48" rx="6" class="il-body" />
      <rect x="114" y="50" width="7" height="20" rx="2" class="il-line" />
      <rect x="42" y="44" width="16" height="32" rx="2" class="il-eco" />
      <rect x="62" y="44" width="16" height="32" rx="2" class="il-eco" />
      <rect x="82" y="44" width="16" height="32" rx="2" class="il-eco" />
      <rect x="102" y="44" width="8" height="32" rx="2" class="il-eco-soft" />
    </g>
  )}

  {tipo === "inversor" && (
    <g>
      <rect x="34" y="30" width="92" height="60" rx="6" class="il-body" />
      <path d="M46 60 q9 -16 18 0 t18 0 t18 0 t18 0" class="il-sun-line" />
    </g>
  )}

  {tipo === "proteccion" && (
    <g>
      <rect x="32" y="30" width="96" height="60" rx="5" class="il-body" />
      <rect x="44" y="42" width="18" height="36" rx="3" class="il-slot" />
      <rect x="71" y="42" width="18" height="36" rx="3" class="il-slot" />
      <rect x="98" y="42" width="18" height="36" rx="3" class="il-slot" />
      <line x1="53" y1="50" x2="53" y2="62" class="il-sun-line" />
      <line x1="80" y1="50" x2="80" y2="62" class="il-sun-line" />
      <line x1="107" y1="50" x2="107" y2="62" class="il-sun-line" />
    </g>
  )}

  {tipo === "cable" && (
    <g>
      <path d="M22 70 C 44 24, 68 116, 90 70 S 128 24, 140 70" class="il-cable" />
      <circle cx="22" cy="70" r="4" class="il-node" />
      <circle cx="140" cy="70" r="4" class="il-node" />
    </g>
  )}

  {tipo === "red" && (
    <g>
      <path d="M80 22 L62 98 M80 22 L98 98 M68 60 L92 60 M63 78 L97 78" class="il-line" />
      <path d="M18 98 H142" class="il-line-soft" />
      <path d="M30 40 Q 80 14 130 40" class="il-cable" />
    </g>
  )}
</svg>

<style>
  .il { width: 100%; height: auto; display: block; }
  .il-base { fill: var(--surface); stroke: var(--line); }
  .il-body { fill: var(--paper); stroke: var(--navy); stroke-width: 1.6; }
  .il-face { fill: var(--paper); stroke: var(--navy); stroke-width: 1.6; }
  .il-grid { stroke: var(--line-strong); stroke-width: 1.2; }
  .il-line { stroke: var(--navy); stroke-width: 1.8; fill: none; stroke-linecap: round; }
  .il-line-soft { stroke: var(--soft); stroke-width: 1.4; fill: none; stroke-linecap: round; }
  .il-screen { fill: var(--eco-tint); stroke: var(--eco); stroke-width: 1.2; }
  .il-eco { fill: var(--eco-tint); stroke: var(--eco); stroke-width: 1.2; }
  .il-eco-soft { fill: var(--eco-line); stroke: none; }
  .il-sun { fill: var(--sun); stroke: var(--sun-strong); stroke-width: 1.4; }
  .il-sun-line { stroke: var(--sun-strong); stroke-width: 2.2; fill: none; stroke-linecap: round; }
  .il-slot { fill: var(--sun-tint); stroke: var(--sun-strong); stroke-width: 1.2; }
  .il-cable { stroke: var(--navy); stroke-width: 2.2; fill: none; stroke-linecap: round; }
  .il-node { fill: var(--paper); stroke: var(--navy); stroke-width: 1.6; }
</style>
