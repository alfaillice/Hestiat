---
// Esquema técnico de una instalación híbrida de autoconsumo con batería (48V).
// Es una representación real y etiquetada, no una ilustración decorativa: muestra el flujo
// paneles -> inversor híbrido -> batería / cuadro / red, con las protecciones indicadas.
---
<figure class="esquema">
  <svg viewBox="0 0 920 360" role="img" aria-labelledby="esq-t esq-d" class="esquema-svg">
    <title id="esq-t">Instalación solar híbrida con batería</title>
    <desc id="esq-d">
      Los paneles pasan por un fusible de continua al inversor híbrido; el inversor gestiona la
      batería, alimenta el cuadro de la vivienda y se conecta a la red para verter o tomar energía.
    </desc>
    <defs>
      <marker id="fl" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M0 0L9 4.5L0 9z" fill="var(--navy)"></path>
      </marker>
    </defs>

    <!-- Paneles -->
    <g class="bx">
      <rect x="24" y="36" width="150" height="104" rx="8" class="bx-pv"></rect>
      <line x1="49" y1="60" x2="149" y2="60" class="pv-l"></line>
      <line x1="49" y1="88" x2="149" y2="88" class="pv-l"></line>
      <line x1="49" y1="116" x2="149" y2="116" class="pv-l"></line>
      <line x1="74" y1="46" x2="74" y2="130" class="pv-l"></line>
      <line x1="99" y1="46" x2="99" y2="130" class="pv-l"></line>
      <line x1="124" y1="46" x2="124" y2="130" class="pv-l"></line>
    </g>
    <text x="99" y="162" class="lb" text-anchor="middle">Paneles solares</text>

    <!-- Inversor híbrido -->
    <rect x="384" y="40" width="168" height="120" rx="8" class="bx-core"></rect>
    <text x="468" y="92" class="lb-core" text-anchor="middle">Inversor</text>
    <text x="468" y="112" class="lb-core" text-anchor="middle">híbrido + MPPT</text>
    <text x="468" y="186" class="lb" text-anchor="middle">Corazón del sistema</text>

    <!-- Batería -->
    <rect x="384" y="236" width="168" height="84" rx="8" class="bx-bat"></rect>
    <text x="468" y="284" class="lb-bat" text-anchor="middle">Batería (LFP)</text>
    <text x="468" y="336" class="lb" text-anchor="middle">Almacena para la noche</text>

    <!-- Cuadro -->
    <rect x="720" y="40" width="152" height="84" rx="8" class="bx"></rect>
    <text x="796" y="86" class="lb-in" text-anchor="middle">Cuadro vivienda</text>
    <text x="796" y="146" class="lb" text-anchor="middle">Consumos de casa</text>

    <!-- Red -->
    <rect x="720" y="196" width="152" height="84" rx="8" class="bx"></rect>
    <text x="796" y="242" class="lb-in" text-anchor="middle">Red eléctrica</text>
    <text x="796" y="302" class="lb" text-anchor="middle">Excedentes y respaldo</text>

    <!-- Conexiones -->
    <line x1="174" y1="88" x2="384" y2="92" class="wire" marker-end="url(#fl)"></line>
    <line x1="552" y1="80" x2="720" y2="80" class="wire" marker-end="url(#fl)"></line>
    <line x1="552" y1="238" x2="640" y2="238" class="wire" marker-end="url(#fl)"></line>
    <path d="M640 238 L720 238" class="wire" marker-end="url(#fl)"></path>
    <line x1="468" y1="160" x2="468" y2="236" class="wire wire-2"></line>

    <!-- Fusibles -->
    <g class="fus"><rect x="266" y="78" width="26" height="20" rx="3"></rect><text x="279" y="70" class="fl" text-anchor="middle">fusible CC</text></g>
    <g class="fus"><rect x="624" y="70" width="26" height="20" rx="3"></rect><text x="637" y="62" class="fl" text-anchor="middle">magnetotérmico</text></g>
  </svg>
  <figcaption>Esquema de una instalación híbrida a 48V. El camper (12V) y la caseta (24V) siguen el mismo flujo con menos componentes.</figcaption>
</figure>
